# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloud collector / backend secrets (never expose to the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local-only inference
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LOCAL_WORKER_ID=owner-laptop

# Optional free API tokens
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=

# Queue policy
MAX_PENDING_JOBS=500
MAX_PENDING_AGE_DAYS=7
LINKEDIN_DRAFT_TTL_HOURS=48
COLLECTION_BATCH_SIZE=50
LOG_LEVEL=INFO
